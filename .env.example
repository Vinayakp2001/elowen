# ==============================================================================
# Elowen — Root Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ==============================================================================

# --- PostgreSQL ---
POSTGRES_USER=elowen
POSTGRES_PASSWORD=changeme
POSTGRES_DB=elowen

# --- FastAPI ---
# Uses the postgres service hostname within Docker network
DATABASE_URL=postgresql://elowen:changeme@postgres:5432/elowen
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
FRONTEND_URL=https://yourdomain.com
ENVIRONMENT=production

# --- Next.js / Payload CMS ---
PAYLOAD_SECRET=changeme-use-a-long-random-string
NEXT_PUBLIC_API_URL=https://yourdomain.com/api
NEXT_PUBLIC_SERVER_URL=https://yourdomain.com
