# Elowen — ENV_FILE template
# Copy this to env.deploy, fill in all values, then run the gh secret set command.
# Never commit env.deploy — delete it after uploading.

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

DATABASE_URL=postgresql://POSTGRES_USER:POSTGRES_PASSWORD@postgres:5432/POSTGRES_DB
PAYLOAD_DATABASE_URL=postgresql://POSTGRES_USER:POSTGRES_PASSWORD@postgres:5432/elowen

PAYLOAD_SECRET=
PAYLOAD_SERVER_URL=https://elowen.co.in

FRONTEND_URL=https://elowen.co.in
ENVIRONMENT=production

NEXT_PUBLIC_API_URL=https://elowen.co.in/api
NEXT_PUBLIC_SERVER_URL=https://elowen.co.in

# PhonePe (PRODUCTION)
PHONEPE_CLIENT_ID=<set-in-ENV_FILE-secret>
PHONEPE_CLIENT_SECRET=<set-in-ENV_FILE-secret>
PHONEPE_CLIENT_VERSION=1
PHONEPE_ENV=PRODUCTION

# Shiprocket (required for live shipment fulfillment)
# Set SHIPROCKET_ENABLED=true to activate real API calls.
# Without valid EMAIL + PASSWORD, the service falls back to stub mode even if ENABLED=true.
SHIPROCKET_ENABLED=true
SHIPROCKET_EMAIL=<set-in-ENV_FILE-secret>
SHIPROCKET_PASSWORD=<set-in-ENV_FILE-secret>
# Shared token verifying the Shiprocket status webhook (and the admin purge endpoint).
# Register the webhook as https://elowen.co.in/api/webhooks/shiprocket?token=<this-value>
SHIPROCKET_WEBHOOK_TOKEN=<set-in-ENV_FILE-secret>

# Non-success order retention window in days (safe default 180).
ORDER_RETENTION_DAYS=180

# Admin data-visibility (read-only Orders/Newsletter views in the Payload panel).
# API_INTERNAL_URL: the web server calls FastAPI server-to-server (container network).
# ADMIN_API_TOKEN: server-only admin secret for the read endpoints — REUSE the same
# value as SHIPROCKET_WEBHOOK_TOKEN (no new credential). Never exposed to the browser.
API_INTERNAL_URL=http://api:8000
ADMIN_API_TOKEN=<same-value-as-SHIPROCKET_WEBHOOK_TOKEN>
